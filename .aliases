alias v='nvim'
alias displays='xrandr | grep "connected" | cut -f1 -d " "xrandr | grep "connected" | cut -f1 -d " "'
alias bg="feh --bg-scale"
alias zz="source ~/.zshrc"
alias cdc="cd ~/git/dotfiles-arch/"
