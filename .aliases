alias list-usb='sudo fdisk -l'
alias mount-usb-sdb1='sudo mount -t vfat /dev/sdb1 /media/usb -o uid=1000,gid=100,utf8,dmask=027,fmask=137'
alias unmount-usb='sudo umount /media/usb'
alias bletooth-sony='sudo bluetoothctl connect 38:18:4C:BD:91:80'
alias sony='sudo bluetoothctl connect 38:18:4C:BD:91:80'
